# Mnemo C2 Bot - VPS Environment Configuration
# 
# Инструкция:
# 1. Переименуйте этот файл в .env
# 2. Заполните значения ниже
# 3. Поместите в директорию /opt/mnemo/

# ============================================
# REQUIRED - ОБЯЗАТЕЛЬНО ЗАПОЛНИТЬ
# ============================================

# Telegram Bot Token от @BotFather
# Получить: https://t.me/BotFather -> /newbot
BOT_TOKEN=your_token_here_REPLACE_ME

# ============================================
# OPTIONAL - ОПЦИОНАЛЬНО
# ============================================

# Уровень логирования: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Путь к файлу логов (если пусто - только консоль)
LOG_FILE=/var/log/mnemo-bot.log

# Путь к базе данных SQLite
# Можно использовать абсолютный путь для VPS
DATABASE_PATH=/opt/mnemo/mnemo.db

# Путь к файлу со словами
WORDS_JSON_PATH=/opt/mnemo/words.json
